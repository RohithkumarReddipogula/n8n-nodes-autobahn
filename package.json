{
	"name": "n8n-nodes-autobahn",
	"version": "0.1.0",
	"description": "n8n community node for the official German Autobahn API: live roadworks, warnings, closures, charging stations, lorry parking and webcams.",
	"license": "MIT",
	"homepage": "https://github.com/RohithkumarReddipogula/n8n-nodes-autobahn",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"autobahn",
		"traffic",
		"roadworks",
		"germany"
	],
	"author": {
		"name": "Rohith Kumar Reddipogula",
		"email": "rohithkumar336699@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/RohithkumarReddipogula/n8n-nodes-autobahn.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/Autobahn/Autobahn.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
